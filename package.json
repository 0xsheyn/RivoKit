{
  "name": "rivokit",
  "version": "0.1.0",
  "_comment_private": "Still private: nothing here is audited and the payout leg is MOCK, so it must not land on the public npm registry by accident. `npm pack` and git/file installs work regardless — see README > Installation.",
  "private": true,
  "description": "An embeddable cross-border settlement SDK on Arc — multi-chain USDC in, local-currency out.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "infra/supabase/migrations",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "next dev demo",
    "setup": "node scripts/setup.mjs",
    "build": "next build demo",
    "build:lib": "tsc -p tsconfig.build.json",
    "prepack": "npm run build:lib",
    "prepare": "npm run build:lib",
    "start": "next start demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@circle-fin/adapter-circle-wallets": "^1.4.3",
    "@circle-fin/adapter-viem-v2": "^1.14.0",
    "@circle-fin/app-kit": "^1.10.0",
    "@circle-fin/smart-contract-platform": "^10.8.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.4",
    "lucide-react": "^1.25.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.38.0",
    "wagmi": "^2.17.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
