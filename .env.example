# RivoKit — contoh environment (Arc Testnet)
#
# Salin ke .env.local dan isi. JANGAN pernah commit .env.local.
# Simpan file recovery entity secret Circle DI LUAR repo.
#   cp .env.example .env.local
#
# Referensi lengkap: docs/DEPLOYMENT.md §1

# ── Supabase (state off-chain) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Circle ─────────────────────────────────────────────────────────────
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=            # 32-byte hex; registrasi sekali sebelum dipakai
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# ── App Kit (swap FX) ──────────────────────────────────────────────────
KIT_KEY=                         # format: KIT_KEY:<keyId>:<keySecret>

# ── Off-ramp fiat ──────────────────────────────────────────────────────
# SERVER-ONLY. Jangan pernah diimpor dari komponen klien — key ini bisa
# memerintahkan pembayaran fiat. CPN self-serve di Circle Console.
CIRCLE_CPN_KEY=
CIRCLE_RAMP_KEY=                 # Circle Mint (kapabilitas "On/off ramp") — opsional

# ── Arc Testnet ────────────────────────────────────────────────────────
# Verifikasi ulang ke docs.arc.io/arc/references/contract-addresses —
# alamat testnet dapat berubah (DEPLOYMENT.md §3, CLAUDE.md §4).
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network

# ── Webhooks ───────────────────────────────────────────────────────────
# Untuk lokal pakai tunnel (mis. ngrok http 3000), lalu daftarkan URL-nya.
WEBHOOK_ENDPOINT_URL=
WEBHOOK_SECRET=

# ── Sumber dana awal (EOA dengan USDC faucet) ──────────────────────────
# Tiga EOA, satu peran masing-masing, tidak ada yang merangkap. Semuanya
# testnet — di Arc, USDC ADALAH gas, jadi ketiganya harus berisi USDC atau
# transaksi gagal sebelum mulai.
#
# Yang TIDAK ada di sini: operator dan merchant. Keduanya wallet Circle
# (OPERATOR_WALLET_ID / MERCHANT_WALLET_ID di bawah, ditulis oleh setup) —
# operator merelai tiap panggilan escrow, merchant menerima escrow dan
# memegang EURC. Kuncinya di Circle, bukan di file ini.

# Mengisi gas wallet Circle lewat `npm run setup`, dan men-deploy kontrak pada
# run pertama. Terpisah dari yang lain karena otoritas deploy tidak boleh
# menempel pada kunci panas mana pun (DEPLOYMENT.md §2).
DEPLOYER_PRIVATE_KEY=

# EOA PENJUAL. Menerima hasil capture order tujuan bank, menandatangani intent
# Permit2/CPN, dan memegang saldo yang di-cash-out (demo/lib/cpn.server.ts
# getSellerSigner). Di produksi penjual tanda tangan di wallet-nya sendiri —
# `ramp.submit` menerima Account apa pun.
#
# DULU bernama RELAYER_PRIVATE_KEY, dan itu keliru: kunci itu tak pernah
# merelai apa pun — yang merelai adalah wallet Circle operator. Tak ada
# fallback ke nama lama, supaya wallet yang sudah kamu pensiunkan tidak
# diam-diam tetap dipakai menandatangani.
SELLER_PRIVATE_KEY=

# EOA pembeli untuk skrip live & demo — menandatangani otorisasi ERC-3009.
BUYER_PRIVATE_KEY=

# Tidak ada SELLER_ADDRESS: alamatnya diturunkan dari SELLER_PRIVATE_KEY di
# atas. Penerima escrow order tujuan WALLET tetap MERCHANT_ADDRESS; order
# tujuan BANK membayar ke penjual, karena off-ramp membelanjakan USDC hasil
# capture dan harus menemukannya di wallet yang menandatangani Permit2.

# ── Diisi otomatis oleh `npm run setup` ────────────────────────────────
# Jangan isi manual — skrip setup yang menulisnya. Setup bersifat idempoten:
# nilai yang sudah ada di sini membuat tahap terkait dilewati.
CIRCLE_WALLET_SET_ID=
DEPLOYER_WALLET_ID=
DEPLOYER_ADDRESS=
OPERATOR_WALLET_ID=
OPERATOR_ADDRESS=
MERCHANT_WALLET_ID=
MERCHANT_ADDRESS=

# Instance Commerce Payments Protocol milik RivoKit sendiri — bukan alamat
# sample Circle. Kolektor terikat permanen ke escrow lewat immutable, jadi
# ketiganya harus berasal dari satu run setup yang sama.
NEXT_PUBLIC_RIVO_ESCROW_ADDRESS=
NEXT_PUBLIC_RIVO_TOKEN_COLLECTOR_ADDRESS=
NEXT_PUBLIC_RIVO_REFUND_COLLECTOR_ADDRESS=

# ── Demo knobs (opsional) ──────────────────────────────────────────────
# Dibaca demo/lib/rivokit.server.ts. Semua punya default yang masuk akal.
RIVO_FEE_BPS=25              # fee operator saat capture; 0 = subsidi penuh
# Default OPERATOR_ADDRESS — dan itu satu-satunya peran yang masih merangkap:
# operator merelai DAN menerima fee. Isi dengan alamat sendiri kalau ingin
# keduanya terpisah. Alamat ini hanya MENERIMA, jadi kuncinya tak pernah dibaca
# server dan wallet-nya tak perlu didanai.
RIVO_FEE_RECEIVER=
MIN_OPERATOR_GAS_USDC=0.5    # createOrder ditolak di bawah ambang ini

# The server-side gate on every demo action that moves money. REQUIRED for any
# public deployment: a production build with this unset refuses those actions
# outright rather than running open. Leave it unset locally and the gate opens,
# so `npm run dev` needs no ceremony.
DEMO_WRITE_KEY=

# Per-action ceilings, applied whether or not the caller is unlocked — the cap,
# not the lock, is what bounds a leaked key. Minor units: 6dp for tokens, 2dp
# for fiat. Defaults are 25 USDC and 25.00.
# DEMO_CAP_TOKEN_MINOR=25000000
# DEMO_CAP_FIAT_MINOR=2500
