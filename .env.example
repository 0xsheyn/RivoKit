# RivoKit — contoh environment (Arc Testnet)
#
# Salin ke .env.local dan isi. JANGAN pernah commit .env.local.
# Simpan file recovery entity secret Circle DI LUAR repo.
#   cp .env.example .env.local
#
# Referensi lengkap: docs/DEPLOYMENT.md §1

# ── Supabase (state off-chain) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Circle ─────────────────────────────────────────────────────────────
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=            # 32-byte hex; registrasi sekali sebelum dipakai
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# ── App Kit (swap FX) ──────────────────────────────────────────────────
KIT_KEY=                         # format: KIT_KEY:<keyId>:<keySecret>

# ── Arc Testnet ────────────────────────────────────────────────────────
# Verifikasi ulang ke docs.arc.io/arc/references/contract-addresses —
# alamat testnet dapat berubah (DEPLOYMENT.md §3, CLAUDE.md §4).
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network

# ── Webhooks ───────────────────────────────────────────────────────────
# Untuk lokal pakai tunnel (mis. ngrok http 3000), lalu daftarkan URL-nya.
WEBHOOK_ENDPOINT_URL=
WEBHOOK_SECRET=

# ── Diisi otomatis oleh `npm run setup` ────────────────────────────────
# Jangan isi manual — skrip setup yang menulisnya.
OPERATOR_WALLET_ID=
OPERATOR_ADDRESS=
MERCHANT_WALLET_ID=
MERCHANT_ADDRESS=
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TOKEN_COLLECTOR_ADDRESS=
NEXT_PUBLIC_REFUND_COLLECTOR_ADDRESS=
